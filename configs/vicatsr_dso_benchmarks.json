{
    "domain": {
        "name": "DSOBenchmarks",
        "dataset": "Nguyen-2",
        "_dataset": "Nguyen-1",
        "_dataset": "Constant-1"
    },
    "algorithm": {
        "name": "VICatSR",
        "operators": {
            "_binary_ops": ["*", "+"],
            "binary_ops": ["+", "-", "*", "/"],
            "_binary_ops": ["+", "-", "*"],
            "_binary_ops": ["+", "*", "/"],
            "unary_ops": ["sin", "cos", "exp", "log"],
            "_unary_ops": ["sin", "cos"]
        },
        "constraints": [
            "inverse_ops",
            "nested_trigs"
        ],
        "prior_mean": 0.35,
        "prior_variance": 1.0,
        "_prior_mean": 0.0,
        "_prior_variance": 100.0,
        "_q_const_variance": 0.1,
        "num_steps": 2000,
        "num_eq_samples": 1000,
        "_max_num_tokens": 3,
        "max_num_tokens": 30,
        "target_policy": {
            "_learning_rate": 2e-4,
            "learning_rate": 5e-4,
            "rnn_hidden_layer_size": 256,
            "_rnn_hidden_layer_size": 32,
            "init_gru_weights_zero": false,
            "parent_input": true,
            "sibling_input": true,
            "previous_input": false
        },
        "remove_x_vars": false,
        "behaviour_policy": "target",
        "_behaviour_policy": "equal_prob_tokens",
        "_behaviour_policy": "enumerate_all",
        "_risk_seeking_epsilon": 0.1,
        "_entropy_lambda": 0.005,
        "baseline": {
            "name": "mean"
        },
        "_baseline": {
            "name": "ewma",
            "alpha": 0.25,
            "jumpstart": true
        },
        "max_likelihood": false,
        "distr_over_consts": false,
        "plotting": true,
        "track_kl_divergence": false,
        "calculate_posteriors": false,
        "enum_exps": false,
        "stop_when_true_expr_found": false,
        "x_seed": 18,
        "verbosity": 1
    },
    "writer": {
        "write_to_file": true
    }
}
