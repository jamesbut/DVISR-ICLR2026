{
    "domain": {
        "name": "WrittenExpression",
        "_expression": "`x1` * `x1` + `x1`",
        "expression": "`x1` * `x1` * `x1` + `x1`",
        "_expression": "`x1` * `x1` * `x1` + `x1` * `x1`",
        "x_mins": [-1.0],
        "x_maxs": [1.0],
        "x_step_sizes": [0.1]
    },
    "algorithm": {
        "name": "VICatSR",
        "operators": {
            "binary_ops": ["*", "+"],
            "_unary_ops": ["sin"]
        },
        "prior_mean": 0.0,
        "prior_variance": 100.0,
        "_q_const_variance": 0.1,
        "num_steps": 250,
        "num_eq_samples": 100,
        "_max_num_tokens": 5,
        "max_num_tokens": 9,
        "target_policy": {
            "learning_rate": 1e-3,
            "_learning_rate": 5e-4,
            "rnn_hidden_layer_size": 256,
            "_rnn_hidden_layer_size": 32,
            "init_gru_weights_zero": false
        },
        "remove_x_vars": false,
        "plotting": false,
        "track_kl_divergence": false,
        "calculate_posteriors": true,
        "behaviour_policy": "target",
        "_behaviour_policy": "equal_prob_tokens",
        "_behaviour_policy": "enumerate_all",
        "_risk_seeking_epsilon": 0.1,
        "_entropy_lambda": 0.005,
        "_baseline": {
            "name": "mean"
        },
        "baseline": {
            "name": "ewma",
            "alpha": 0.25
        },
        "max_likelihood": true,
        "distr_over_consts": false,
        "x_seed": 18
    }
}
